# Copia este archivo como .env.alwaysdata y completa los valores.
# NUNCA subas .env.alwaysdata al repositorio.

DEBUG=0
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_DE_MAS_DE_50_CARACTERES_2026_9f3a
ALLOWED_HOSTS=localhost,127.0.0.1,tu-cuenta.alwaysdata.net
CSRF_TRUSTED_ORIGINS=https://tu-cuenta.alwaysdata.net

# Base de datos MySQL/MariaDB en Alwaysdata
DB_ENGINE=mysql
DB_NAME=tu-cuenta_tu-base
DB_USER=TU_USUARIO
DB_PASSWORD=TU_PASSWORD
DB_HOST=mysql-tu-cuenta.alwaysdata.net
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Alwaysdata termina TLS en su proxy
USAR_PROXY_SSL=1
USAR_X_FORWARDED_HOST=1
USAR_X_FORWARDED_FOR=1
