# Copia este archivo como .env y completa los valores reales.
# El sistema usa MySQL en Alwaysdata; también puedes usar SQLite en local.

# ------------------------------------------------------------------ General
DEBUG=1
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_DE_MAS_DE_50_CARACTERES_2026_9f3a
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------- MySQL en Alwaysdata
DB_ENGINE=mysql
DB_NAME=tu-cuenta_tu-base
DB_USER=TU_USUARIO
DB_PASSWORD=TU_PASSWORD
DB_HOST=mysql-tu-cuenta.alwaysdata.net
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Local (runserver): sin proxy ni redirección forzada a HTTPS.
SECURE_SSL_REDIRECT=0
USAR_PROXY_SSL=0
USAR_X_FORWARDED_HOST=0
USAR_X_FORWARDED_FOR=0

# Alternativa sin conexión (SQLite local):
# DB_ENGINE=sqlite

# En Render, configura estas variables en el dashboard (ver docs/RENDER.md).
# Render inyecta RENDER_EXTERNAL_HOSTNAME automáticamente.
