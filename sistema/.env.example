# Copia este archivo como .env y ajusta los valores.
# Para producción en Alwaysdata usa .env.alwaysdata.example
# y ejecuta los comandos con ENV_FILE=.env.alwaysdata

# ------------------------------------------------------------------ Desarrollo
DEBUG=1
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_DE_MAS_DE_50_CARACTERES_2026_9f3a
